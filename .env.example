# Postgres — required for persistence. Railway provides DATABASE_URL in prod.
# Preview mode (unset) uses in-memory stores; data resets on restart.
DATABASE_URL=postgres://user:pass@localhost:5432/compliance_ai

# LLM providers — ANTHROPIC_API_KEY is required for the reviewer to run.
ANTHROPIC_API_KEY=
# OPENAI_API_KEY is optional (fallback embedder or alternative provider).
OPENAI_API_KEY=

# Auth — set NEXTAUTH_SECRET (32+ random bytes) to turn on real auth.
# Preview mode (unset) gates nothing: every request gets a synthetic
# "preview" session. Useful for local dev and anonymous demos.
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# Optional OAuth providers — activate by setting both id + secret.
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Optional integrations (inactive unless set)
SLACK_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
