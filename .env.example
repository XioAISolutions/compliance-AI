# Postgres - required for persistence. Railway can inject DATABASE_URL from
# a Postgres service. If unset, preview mode uses in-memory stores and data
# resets on restart.
DATABASE_URL=postgres://user:pass@localhost:5432/compliance_ai

# LLM provider for review/chat.
# Hosted preview: set LLM_PROVIDER=openai and OPENAI_API_KEY.
# Private/local install: set LLM_PROVIDER=ollama and run Ollama locally.
# Legacy Anthropic deployments still work with LLM_PROVIDER=anthropic.
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
OPENAI_BASE_URL=https://api.openai.com/v1

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=llama3.1:8b
OLLAMA_API_KEY=

ANTHROPIC_API_KEY=

# Auth - set NEXTAUTH_SECRET (32+ random bytes) to turn on real auth.
# Preview mode (unset) gates nothing: every request gets a synthetic
# "preview" session. Useful for local dev and anonymous demos.
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# Optional OAuth providers — activate by setting both id + secret.
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Optional integrations (inactive unless set)
SLACK_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=

# Milan AI Week partner integrations — each activates a live path on
# /demo/milan and lights up the corresponding row in the partner-status
# card. All four are optional; without them the demo falls back to
# deterministic output and smoke tests stay credential-free.
#
# Gemini — planner + multimodal reasoning. Keys from aistudio.google.com
# auto-enable the Generative Language API; Google Cloud keys need the
# API enabled on the project that owns the key.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Featherless — open-weights inference for sovereign / private review
# lanes (Redline Agent). Set the host running this app in your
# Featherless dashboard's IP allowlist.
FEATHERLESS_API_KEY=
FEATHERLESS_MODEL=meta-llama/Meta-Llama-3.1-8B-Instruct
FEATHERLESS_BASE_URL=https://api.featherless.ai/v1

# Speechmatics — voice intelligence for sales / investor / compliance
# call transcripts. Allowlist the deploy IP in the Speechmatics portal.
SPEECHMATICS_API_KEY=
SPEECHMATICS_BASE_URL=https://asr.api.speechmatics.com/v2

# Vultr — hosting partner. The app does NOT call Vultr's control-plane
# API at runtime; setting either env var just lights up the partner
# row. The actual VULTR_API_KEY belongs in your local deploy tooling /
# CI, never in the running app's env, because it can spin up paid
# infrastructure on your account.
VULTR_DEPLOY=
# VULTR_API_KEY=  # keep this in CI / your local Vultr CLI, not here
