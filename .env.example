# Ollama (local inference)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_CHAT_MODEL=llama3.1:8b

# Optional: Cloud model for validation / comparison
# ANTHROPIC_API_KEY=sk-ant-…
# OPENAI_API_KEY=sk-…

# Paths
CORPUS_PATH=./compliance-brain/01-corpus
VECTOR_STORE_PATH=./compliance-brain/01-corpus/vectors
CITATION_LOG_PATH=./compliance-brain/02-citations/citation-log.json
AUDIT_LOG_PATH=./compliance-brain/04-audit/query-log.json

# Chunking
CHUNK_SIZE=500
CHUNK_OVERLAP=50
