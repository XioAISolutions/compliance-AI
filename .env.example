# Postgres — Railway provides DATABASE_URL in prod
DATABASE_URL=postgres://user:pass@localhost:5432/compliance_ai

# LLM providers (at least one required for /api/chat)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Auth
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# Optional integrations (off unless set)
SLACK_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=

# Deploy-time build info (Railway injects these automatically via the
# RAILWAY_* vars; the values here are just fallbacks for local dev).
NEXT_PUBLIC_APP_VERSION=0.4.0
NEXT_PUBLIC_GIT_SHA=
NEXT_PUBLIC_BUILT_AT=
